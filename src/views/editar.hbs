<div class="container">
    <div class="row">
        <div class="col-md-5 offset-md3">
            <div class="card card-body bg-dark p-4 text-white">
                <h4>Actualizar Producto</h4>
                <form action="/productos/{{productos._id}}/update" method="post">
    <div>
        <label for="nombre">Modificar producto</label>
        <input type="text" name="nombre" placeholder="Name" 
        value="{{productos.nombre}}" 
        class="form-control bg-dark text-white">
    </div>
    <div>
        <label for="descripcion">Modificar Descripcion</label>
        <textarea name="descripcion" cols="30" rows="3"
        placeholder="Descripcion" class="form-control bg-dark text-white">
        {{productos.descripcion}}</textarea>
    </div>
    <div>
        <label for="precio">Modificar precio</label>
        <input type="text" name="precio" placeholder="value"
         value="{{productos.precio}}" class="form-control bg-dark text-white">
    </div>
    <button class="btn btn-info">Actualizar</button>
</form>
            </div>
        </div>
    </div>
</div>